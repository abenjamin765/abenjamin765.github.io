<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }}{% else %}blog{% endif %} | Aaron Benjamin</title>
  {% if description %}
  <meta name="description" content="{{ description | e }}">
  <meta property="og:description" content="{{ description | e }}">
  {% endif %}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title | e }} | Aaron Benjamin">
  <link rel="canonical" href="https://aaronbenjamin.design{{ page.url }}">
  <meta property="og:url" content="https://aaronbenjamin.design{{ page.url }}">
  <meta property="og:image" content="https://aaronbenjamin.design{{ shareImage }}">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="/assets/img/folio/favicon.svg">
  <link rel="stylesheet" href="{{ '/assets/style/site.css' | relativeFromSiteRoot(page) }}">
</head>
<body class="site">
  <a class="visually-hidden" href="#main">skip to content</a>

  <header class="hdr">
    <div class="hdr__row">
      <a class="logo" href="/" aria-label="Aaron Benjamin home">
        <span class="logo__mark" aria-hidden="true"><span class="logo__dot"></span></span>
        <span class="logo__wordmark">Aaron Benjamin</span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a class="nav__a" href="/writing.html">writing</a>
        <a class="nav__a" href="/">portfolio</a>
      </nav>
      <div class="hdr__tools">
        <a class="btn btn--solid" href="mailto:hello@aaronbenjamin.design">contact</a>
      </div>
    </div>
  </header>

  <main id="main" class="site-main">
    {% if isPost %}
    <article class="post">
      {% if page.date %}
      <p class="post-meta">
        <time class="post-meta__time" datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time>
        <span class="post-meta__sep" aria-hidden="true">·</span>
        <span class="post-meta__kind">Essay · {{ readingMinutes }} min read</span>
      </p>
      {% endif %}
      {{ content | safe }}
    </article>
    {% else %}
    {{ content | safe }}
    {% endif %}
  </main>

  <footer class="ftr">
    <div class="ftr__inner">
      <p class="ftr__legal">© 2026 Aaron Benjamin</p>
      <nav class="ftr__nav" aria-label="Footer">
        <a href="/resume.html">resume</a>
        <a href="mailto:hello@aaronbenjamin.design">contact</a>
      </nav>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var hdr = document.querySelector(".hdr");
      function onScroll() {
        if (hdr) hdr.classList.toggle("hdr--scrolled", window.scrollY > 8);
      }
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | e }} | Aaron Benjamin</title>
  <meta name="description" content="{{ description | e }}">
  <link rel="canonical" href="{{ portfolio.portfolioSite.baseUrl }}{{ page.url }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title | e }} | Aaron Benjamin">
  <meta property="og:description" content="{{ description | e }}">
  <meta property="og:url" content="{{ portfolio.portfolioSite.baseUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ portfolio.portfolioSite.baseUrl }}{{ shareImage }}">
  <meta property="og:image:alt" content="{{ title | e }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image:alt" content="{{ title | e }}">
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | e }}">
  <meta name="twitter:description" content="{{ description | e }}">
  <meta name="twitter:image" content="{{ portfolio.portfolioSite.baseUrl }}{{ shareImage }}">
  <link rel="icon" type="image/svg+xml" href="/assets/img/folio/favicon.svg">
  <link rel="stylesheet" href="/assets/style/folio.css">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":{{ title | jsonLd | safe }},"description":{{ description | jsonLd | safe }},"url":{{ (portfolio.portfolioSite.baseUrl + page.url) | jsonLd | safe }},"image":{{ (portfolio.portfolioSite.baseUrl + shareImage) | jsonLd | safe }},"datePublished":{{ (page.date | isoDate) | jsonLd | safe }},"author":{"@type":"Person","name":"Aaron Benjamin","url":{{ portfolio.portfolioSite.baseUrl | jsonLd | safe }}}}</script>
</head>
<body class="folio folio--writing">
  <a class="visually-hidden" href="#main">Skip to content</a>
  {% folioHeader 'writing', 'Writing', '/writing.html' %}
  <main id="main" class="folio-main folio-main--case writing-main">
    <article class="post">
      <p class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time> · Essay · {{ readingMinutes }} min read</p>
      {{ content | safe }}
      <aside class="writing-related" aria-labelledby="related-work-title">
        <h2 id="related-work-title">See the thinking in practice</h2>
        <p><a href="/design-dash.html">The Design Dash</a> connects product evidence and object definitions to an implementation plan. <a href="/many-hats.html">Many Hats</a> makes responsibilities, independent critique, and human decisions explicit.</p>
      </aside>
    </article>
    {% folioFooter %}
  </main>
</body>
</html>

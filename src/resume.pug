include includes/folio-shared.pug

-
    const identity = resume.identity
    const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
    const formatMonth = (value) => {
        const [year, month] = value.split('-')
        return month ? MONTHS[Number(month) - 1] + ' ' + year : year
    }
    const formatDates = (role) => {
        if (!role.start) return ''
        const end = role.end ? formatMonth(role.end) : 'Present'
        return formatMonth(role.start) + ' - ' + end
    }
    // Must match `.work-experience-milestone:nth-of-type(n + 6)` in _resume-print.scss.
    const PRINT_ROLE_LIMIT = 5
    const earlierRoles = resume.experience.slice(PRINT_ROLE_LIMIT).map((role) => role.company)
    const skillSectionIds = { focus: 'focusAreas', capability: 'hardSkills' }

doctype html
html(lang="en")
    head
        +folioHead('Aaron Benjamin | Résumé', 'Aaron Benjamin is a product designer who leads complex UX work across marketplaces, education, commerce, and internal tools.', '/resume.html', 'resume')
        link(rel="stylesheet", href="/style.css", media="screen")
        link(rel="stylesheet", href="/narrative.css", media="screen")
    body.folio--resume
        a.skip-link.no-print(href="#main") Skip to content
        header.portfolio-header.no-print
            a(href="/") Aaron Benjamin
            nav.portfolio-links(aria-label="Main navigation")
                a(href="/work.html") Work
                a(href="/resume.html", aria-current="page") Résumé
                a(href="mailto:" + portfolioSite.email) Contact

        main#wrapper
            .resume-main#main(tabindex="-1")
                header.resume-intro
                    if identity.headline
                        p.resume-kicker= identity.headline.text
                    h1= identity.name
                    if identity.summary
                        p.resume-summary= identity.summary.text
                    .resume-actions.no-print
                        a.intro-button.intro-button--primary.resume-download(href="/assets/Aaron-Benjamin-Resume.pdf", download="Aaron-Benjamin-Resume.pdf") Download résumé (PDF)
                        a.resume-work-link(href="/work.html") Explore my work

                section#workExperience(aria-labelledby="experience-title")
                    h2#experience-title Experience
                    each role, roleIndex in resume.experience
                        article.work-experience-milestone
                            h3
                                span= role.title
                                span.resume-role-separator= ' / '
                                span.light= role.company
                            p.work-experience-date-range= [formatDates(role), role.location].filter(Boolean).join(' · ')
                            if role.summary
                                p.resume-earlier= role.summary.text
                            if role.bullets.length > 1
                                ul.work-experience-accomplishments
                                    each bullet, bulletIndex in role.bullets
                                        li(class=roleIndex >= 2 && bulletIndex >= 2 ? 'resume-bullet--print-hide' : null)= bullet.text
                            else if role.bullets.length === 1
                                p.resume-earlier= role.bullets[0].text

            aside.resume-aside(aria-label="Contact and background")
                section#contact(aria-labelledby="contact-title")
                    h2#contact-title Contact
                    each email in identity.emails
                        a(href='mailto:' + email.address)= email.address
                    each phone in identity.phones
                        a(href='tel:' + phone.number.replace(/[^0-9+]/g, ''))= phone.number
                    if identity.website
                        a(href=portfolioSite.baseUrl + '/')= identity.website
                    if identity.linkedin
                        a(href=identity.linkedin) LinkedIn
                    each location in identity.locations
                        p#location= location.text

                each group in resume.skills
                    - const sectionId = skillSectionIds[group.kind] || 'skills-' + group.kind
                    section(id=sectionId, aria-labelledby=sectionId + '-title')
                        h2(id=sectionId + '-title')= group.label
                        ul.resume-list
                            each item in group.items
                                li= item

                if resume.education.length
                    section#education(aria-labelledby="education-title")
                        h2#education-title Education
                        each item in resume.education
                            - const place = [item.credential, item.institution, item.location].filter(Boolean).join(', ')
                            p= place + (item.year ? ' (' + item.year + ')' : '')

                if earlierRoles.length
                    section.resume-early-print(aria-labelledby="earlier-title")
                        h2#earlier-title Earlier roles
                        p= earlierRoles.join(' · ')

        footer.story-footer.no-print
            a(href="/") Aaron Benjamin
            nav(aria-label="Explore the portfolio")
                a(href="/work.html") Work
                a(href="/writing.html") Writing
                a(href="mailto:" + portfolioSite.email) Let’s talk
                a(href="#main") Back to top ↑

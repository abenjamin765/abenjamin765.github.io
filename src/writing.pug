include includes/folio-shared.pug
- const featured = writingPosts[0]
- const remaining = writingPosts.slice(1)

doctype html
html(lang="en")
    head
        +folioHead('Writing | Aaron Benjamin — product design', 'Essays on product systems, design judgment, and responsible use of AI in product work.', '/writing.html')
    body.folio.folio--writing
        +folioShell
        +folioHeader('writing', 'Selected work', '/#work')
        main#main.folio-main.folio-main--case.writing-main
            header.writing-intro
                p.folio-eyebrow Thinking behind the work
                h1 Writing
                p Essays on product systems, design judgment, and how teams use AI.
            if featured
                article.writing-feature(aria-labelledby="featured-essay-title")
                    img(src="/assets/img/hero-ai.png" srcset=folioSrcset("/assets/img/hero-ai.png") sizes="(max-width: 600px) calc(100vw - 72px), (max-width: 900px) calc(44.4444vw - 65.7778px), (max-width: 960px) calc(44.4444vw - 51.5556px), 375px" fetchpriority="high" alt="Illustrated interface sketch for a teacher dashboard" width="1600" height="900")
                    .writing-feature__body
                        p.writing-meta
                            time(datetime=featured.isoDate)= featured.displayDate
                            | &#32;· #{featured.readingMinutes} min read
                        h2#featured-essay-title= featured.title
                        p= featured.description
                        a.folio-btn(href=featured.href) Read the essay
            if remaining.length
                section.writing-more(aria-labelledby="latest-title")
                    h2#latest-title More essays
                    each post in remaining
                        article
                            h3
                                a(href=post.href)= post.title
                            p= post.description
            +folioFooter(false)

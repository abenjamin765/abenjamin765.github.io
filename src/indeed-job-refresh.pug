html(lang="en")
    head
        +folioHead("The job was still open. Its visibility had faded. | Aaron Benjamin", "Employers were closing and reposting stale jobs to get noticed again. I designed Job Refresh around that existing need—and the information that needed to change with it.", "/indeed-job-refresh.html", "folio", "/assets/img/folio/project--job-refresh/hero-job-refresh.png", "shared-footer-20261003")
    body.folio.folio--case.folio--indeed
        +folioShell
        +folioHeader("work", "Indeed Job Refresh", "/#indeed-job-refresh")
        main#main.folio-main.folio-main--case
            article.folio-case
                +caseHero
                    .folio-case__intro
                        p.folio-eyebrow Indeed · Indeed Job Refresh
                        h1 The job was still open. Its visibility had faded.
                        p.folio-case__dek Employers recreated jobs to make them look active again. I connected that research finding to a platform initiative and proposed Refresh: support the behavior employers wanted while giving job seekers more current information.
                    figure.folio-case__hero-media
                        img(src="assets/img/folio/project--job-refresh/hero-job-refresh.png" srcset=folioSrcset("assets/img/folio/project--job-refresh/hero-job-refresh.png") sizes="(max-width: 600px) calc(100vw - 64px), (max-width: 900px) calc(100vw - 112px), 1100px" alt="Job Refresh eligibility message with a Refresh this job action, framed by illustrations from the freemium strategy deck" width="1800" height="720" fetchpriority="high")
                    +caseFacts
                        .folio-case__fact
                            dt Role
                            dd Senior UX Designer
                        .folio-case__fact
                            dt Scope
                            dd User testing, cross-team proposal, information architecture, interaction design, messaging, and prototypes
                        .folio-case__fact

include includes/folio-shared.pug

doctype html
html(lang="en")
    head
        +folioHead('Aaron Benjamin | Staff / Principal product design', portfolioSite.description, '/')
    body.folio.folio--home
        +folioShell
        +folioHeader('work')
        main#main.folio-main
            section.folio-hero(aria-labelledby="hero-title")
                .folio-hero__inner
                    .folio-hero__copy
                        h1.folio-hero__title#hero-title
                            span.folio-hero__kicker I help teams make sense of complex problems.
                            span.folio-hero__statement
                                | Then we ship something&#32;
                                span.folio-hero__rotator(aria-hidden="true")
                                    span.folio-hero__word.is-current glorious
                                    span.folio-hero__word useful
                                    span.folio-hero__word clear
                                    span.folio-hero__word accessible
                                    span.folio-hero__word thoughtful
                                    span.folio-hero__word delightful
                                    span.folio-hero__word scalable
                                    span.folio-hero__word playful
                                span.visually-hidden glorious
                        p.folio-hero__dek I’m a UX and product designer with 10+ years of experience across Amazon, The Home Depot, HP, and AT&T. I make complex systems understandable, turn research into product decisions, and help teams carry those decisions into delivery.
                        button.folio-motion-toggle(type="button" hidden aria-pressed="false") Pause word rotation
                    .folio-hero__media
                        img(src="assets/img/folio/hero-hi.png" srcset=folioSrcset("assets/img/folio/hero-hi.png") sizes="(max-width: 600px) 120px, 185px" alt="Illustrated portrait of Aaron Benjamin waving hello" width="238" height="250")
            section.folio-work#work(aria-labelledby="selected-work-title")
                .folio-work__inner
                    .folio-section-head
                        p.folio-eyebrow#selected-work-title Selected product stories
                    +projectCard({"id": "classroom", "title": "Classroom Assignment Management", "status": "Renaissance · Senior UX Designer", "dek": "I challenged the MVP and coordinated a priority view with student identities.", "outcome": "Shipped in six weeks; fewer trips to separate reports.", "href": "/classroom-assignment-management.html", "cta": "Read the story →", "feature": true, "image": {"src": "assets/img/folio/thumbnails/classroom.png", "alt": "Classroom assignments grouped by urgency, with overdue reading and math activities", "width": 880, "height": 660}, "hook": "Eight finished. Which two needed help?"})
                    +projectCard({"id": "indeed-job-refresh", "title": "Job Refresh", "status": "Indeed · Senior UX Designer", "dek": "I connected employer research to a cross-team proposal for renewing the existing job.", "outcome": "Free for six months, then included in Sponsored Jobs.", "href": "/indeed-job-refresh.html", "cta": "Read the story →", "feature": true, "hook": "The job was still open. Its visibility had faded.", "image": {"src": "assets/img/folio/thumbnails/indeed-job-refresh.png", "alt": "Job Refresh prompt explaining eligibility and offering Refresh this job", "width": 880, "height": 660}})
                    +projectCard({"id": "curbside-pickup", "title": "Curbside Pickup", "status": "The Home Depot · Staff-level product design", "dek": "I researched the arrival gap and proposed clearer pickup communication across email and app.", "outcome": "A 50-store pilot reported clearer expectations and fewer fulfillment-change calls.", "href": "/curbside-pickup.html", "cta": "Read the story →", "feature": true, "image": {"src": "assets/img/folio/thumbnails/curbside-pickup.png", "alt": "Home Depot pickup email on a phone with arrival-time choices", "width": 880, "height": 660}, "hook": "The wait was short. The uncertainty was not."})
            section.folio-editorial-section(aria-labelledby="leadership-title")
                .folio-section-head
                    p.folio-eyebrow#leadership-title Leadership in practice
                +projectCard({"id": "home-depot-design-leadership", "title": "Design Leadership at The Home Depot", "status": "The Home Depot · UX MEOW", "dek": "Co-founded UX MEOW to connect interns, designer mentors, and innovation projects through a guided team sprint.", "outcome": "Six to 16 project teams; three participants accepted UX-team roles.", "href": "/home-depot-design-leadership.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/home-depot-design-leadership.png", "alt": "UX MEOW illustration with a Home Depot cap and laptop", "width": 880, "height": 660}})
            section.folio-editorial-section(aria-labelledby="more-work-title")
                .folio-section-head
                    p.folio-eyebrow#more-work-title Product systems
                .folio-work-list
                        +projectCard({"id": "price-adjustments", "title": "Home Depot Price Adjustments", "status": "The Home Depot · Staff-level product design", "dek": "I designed an anchored markdown flow around store research and approval rules.", "outcome": "Piloted in 50 stores, then rolled out chain-wide.", "href": "/price-adjustments.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/price-adjustments.png", "alt": "Home Depot markdown form showing amount, quantity, and Apply controls", "width": 880, "height": 660}})
                        +projectCard({"id": "green-loom", "title": "Green Loom", "status": "Green Loom · Co-founder", "dek": "I separated product identity, store offers, stock, and lab evidence.", "outcome": "Completed catalog with evidence checks and a public schema; operator validation remains.", "href": "/green-loom.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/green-loom.png", "alt": "Green Loom catalog concept showing product details beside stock status", "width": 880, "height": 660}})
                        +projectCard({"id": "a-to-z-first-claim", "title": "Amazon A-to-z: First Claim", "status": "Amazon · UX Designer II", "dek": "I redesigned the first-claim email around the seller’s next action.", "outcome": "The wider program reported improved confidence and fewer related support calls.", "href": "/a-to-z-first-claim.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/a-to-z-first-claim.png", "alt": "Amazon A-to-z claims dashboard beside the first-claim email", "width": 880, "height": 660}})
            section.folio-tools(aria-labelledby="tools-title")
                .folio-section-head
                    p.folio-eyebrow#tools-title Design practice
                .folio-project-pair
                        +projectCard({"id": "design-dash", "title": "Design Dash", "status": "Open-source process · Author", "dek": "Connect product evidence, models, requirements, and interface decisions.", "outcome": "A connected plan with Object Guides, wireframes, and technical requirements.", "href": "/design-dash.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/tile-design-dash.jpg", "alt": "The Design Dash logo", "width": 840, "height": 200}})
                        +projectCard({"id": "many-hats", "title": "Many Hats", "status": "Open-source agent system · Author", "dek": "Give specialists explicit responsibilities and keep decisions with the human.", "outcome": "Public v0.1 with a replayable fictional demonstration.", "href": "/many-hats.html", "cta": "Read the story →", "feature": false, "image": {"src": "assets/img/folio/thumbnails/tile-many-hats.jpg", "alt": "A person wearing a stack of hats beside the tagline: Specialized skills for all those voices in your laptop.", "width": 840, "height": 200}})
            section.folio-editorial-section#about(aria-labelledby="about-title")
                .folio-section-head
                    p.folio-eyebrow About Aaron
                    h2#about-title Close to the problem. Close to the craft.
                    p My work has taken me through classrooms, marketplaces, stores, and enterprise tools. I’m currently a Senior UX Designer at Renaissance, connecting research and product models with the details people need to act.
                    p I’m interested in Staff and Principal IC work where I can shape direction, stay involved in delivery, and help others make better decisions along the way.
                    a.folio-text-link(href="/resume.html") Explore my experience →
                    p
                        a.folio-text-link(href="/writing.html") Read my writing →
            +folioFooter(true, 'Have a complex problem your team is working through?', null, true)
        script(src="assets/js/hero-rotator.js" defer)

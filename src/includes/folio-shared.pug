include project-catalog.pug
include image-variants.pug

//- Lucide static SVGs, vendored with their ISC/MIT license.
mixin folioIcon(name)
    if name === 'arrow-left'
        include ../assets/icons/lucide/arrow-left.svg
    else if name === 'arrow-right'
        include ../assets/icons/lucide/arrow-right.svg
    else if name === 'chevron-down'
        include ../assets/icons/lucide/chevron-down.svg
    else if name === 'expand'
        include ../assets/icons/lucide/expand.svg
    else if name === 'shrink'
        include ../assets/icons/lucide/shrink.svg
    else if name === 'plus'
        include ../assets/icons/lucide/plus.svg
    else if name === 'minus'
        include ../assets/icons/lucide/minus.svg
    else if name === 'ellipsis-vertical'
        include ../assets/icons/lucide/ellipsis-vertical.svg
    else if name === 'trash-2'
        include ../assets/icons/lucide/trash-2.svg

mixin folioHead(pageTitle, description, pagePath, stylesheet, shareImage, stylesheetVersion)
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= pageTitle
    meta(name="description", content=description)
    link(rel="canonical", href=portfolioSite.baseUrl + pagePath)
    meta(property="og:type", content="website")
    meta(property="og:title", content=pageTitle)
    meta(property="og:description", content=description)
    meta(property="og:url", content=portfolioSite.baseUrl + pagePath)
    meta(property="og:image", content=portfolioSite.baseUrl + (shareImage || portfolioSite.shareImage))
    meta(name="twitter:card", content="summary_large_image")
    meta(name="twitter:title" content=pageTitle)
    meta(name="twitter:description" content=description)
    meta(name="twitter:image" content=portfolioSite.baseUrl + (shareImage || portfolioSite.shareImage))
    meta(property="og:image:alt" content=pageTitle)
    meta(property="og:image:width" content="1200")
    meta(property="og:image:height" content="630")
    meta(name="twitter:image:alt" content=pageTitle)
    script(type="application/ld+json")!= JSON.stringify({"@context":"https://schema.org","@type":"WebPage",name:pageTitle,description,url:portfolioSite.baseUrl + pagePath,isPartOf:{"@type":"WebSite",name:portfolioSite.name,url:portfolioSite.baseUrl},author:{"@type":"Person",name:portfolioSite.name,url:portfolioSite.baseUrl,sameAs:portfolioSite.sameAs}}).replace(/</g, '\\u003c')
    link(rel="icon", type="image/svg+xml", href="/assets/img/folio/favicon.svg")
    link(rel="stylesheet", href="/assets/style/" + (stylesheet || 'folio') + ".css" + (stylesheetVersion ? '?v=' + stylesheetVersion : ''))

//- Skip link and gold blob that every folio page pastes at the top of <body>.
mixin folioShell
    a.visually-hidden(href="#main") Skip to content

    .folio__decor(aria-hidden="true")
        img.folio__decor-img(src="assets/img/folio/blob.svg", alt="")

//- backHref defaults to /#work so existing pages keep the current destination.
mixin folioHeader(active, projectTitle, backHref, action)
    - projectTitle = folioProjects[(backHref || "").replace("/#", "")]?.title || projectTitle
    header.folio-hdr
        .folio-hdr__inner
            if projectTitle
                a.folio-hdr__name.folio-hdr__name--project(href=(backHref || '/#work') aria-label=backHref === "/writing.html" ? "Back to Writing" : projectTitle === "Selected work" ? "Back to selected work" : `Back to selected work: ${projectTitle}`)
                    span.folio-hdr__back-icon(aria-hidden="true")
                        +folioIcon('arrow-left')
                    span= projectTitle
            else
                a.folio-hdr__name(href="/") Aaron Benjamin
            nav.folio-nav(aria-label="Primary")
                if action
                    a.folio-btn.folio-nav__cta(href=action.href download=action.download ? true : null)= action.label
                else
                    a.folio-btn.folio-nav__cta(href="/resume.html" aria-current=active === 'resume' ? 'page' : null) Resume

//- next is an optional { href, label } case link. portrait defaults off so case pages stay text-only.
mixin folioFooter(showResume, lead, next, portrait)
    footer.folio-footer(class=portrait ? 'folio-footer--portrait' : null)
        if portrait
            img.folio-footer__portrait(src="assets/img/folio/hero-portrait.png" alt="Illustrated portrait of Aaron Benjamin waving hello" width="238" height="250" loading="lazy")
        .folio-footer__body
            p.folio-footer__lead= lead || 'If this work is close to what your team needs, I’d like to hear from you.'
            a.folio-footer__contact(href="mailto:hello@aaronbenjamin.design") Email Aaron
            if next
                a.folio-footer__next(href=next.href)
                    = next.label
                    span(aria-hidden="true")
                        +folioIcon('arrow-right')
            if showResume !== false && !next
                a.folio-footer__resume(href="/resume.html") View Resume
            nav.folio-footer__nav(aria-label="Footer")
                a(href="/#work") Selected work
                a(href="/writing.html") Writing

//- Shared case-study closing component; each page supplies its invitation and next story.
mixin caseStudyFooter(lead, next)
    - next = {...next, title: folioProjectForUrl(next.href)?.title || next.title}
    footer.folio-footer.case-close(aria-label="Contact and next case study")
        .case-close__contact
            h2 Discuss this project
            p= lead
            a.folio-btn.case-close__email(href="mailto:hello@aaronbenjamin.design") Email Aaron
            nav.folio-footer__nav(aria-label="Footer")
                a(href="/#work") Selected work
                a(href="/writing.html") Writing
        a.case-close__next(href=next.href)
            span.case-close__label Next case study
            span.case-close__title= next.title
            span.case-close__arrow(aria-hidden="true")
                +folioIcon('arrow-right')

//- ——— Homepage cards ———

//- One card shape for a linked case (card.href + card.image) and an email preview
//- (card.previewName + card.ctaHref). Copy stays in the caller as arguments.
mixin projectCard(card)
    - card = {...card, ...(folioProjects[card.id] ? {title: folioProjects[card.id].title, href: folioProjects[card.id].href} : {})}
    article.folio-project(id=card.id class=card.feature ? 'folio-project--feature' : null)
        if card.href
            a.folio-project__link(href=card.href)
                .folio-project__media
                    if card.image
                        img(src=card.image.src, srcset=folioSrcset(card.image.src), sizes=card.feature ? "(max-width: 700px) calc(100vw - 72px), (max-width: 960px) 45vw, 443px" : "(max-width: 700px) calc(100vw - 72px), 280px", alt=card.image.alt, width=card.image.width, height=card.image.height, loading="lazy")
                    else
                        .folio-project__placeholder
                            span Project preview
                            strong= card.visual
                            //- Detailed art direction lives in the case study and private briefs.
                .folio-project__copy
                    h3.folio-project__title= card.title
                    p.folio-project__status= card.status
                    if card.hook
                        p.folio-project__hook= card.hook
                    p.folio-project__dek= card.dek
                    if card.outcome
                        p.folio-project__proof= card.outcome
                    span.folio-project__cta= card.cta
        else
            .folio-project__media.folio-project__media--fill
                span.folio-project__preview-name= card.previewName
            .folio-project__copy
                p.folio-project__status= card.status
                h3.folio-project__title= card.title
                p.folio-project__dek= card.dek
                a.folio-project__cta(href=card.ctaHref)= card.cta

//- 01–03 "How I work" block. Body prose stays in the caller as a block.
mixin claim(num, title)
    article.folio-claim
        .folio-claim__head
            p.folio-claim__num= num
            h3.folio-claim__title= title
        p.folio-claim__body
            block

//- ——— Case study devices ———

//- Shared opening: title and dek, media, then facts supplied by the page.
mixin caseHero
    header.folio-case__hero
        block

//- Definition list wrapper; the caller supplies .folio-case__fact items as a block
//- so every label and value stays literal in the page.
mixin caseFacts
    dl.folio-case__facts
        block

//- Section wrapper. opts: { labelledby, tint, final, prose, figure }.
//- Default wraps the block in .folio-case__prose and can append a simple image
//- figure (opts.figure). Set opts.prose = false to own the full section body
//- (used for the demo and the Green Loom diagram figures).
mixin caseSection(opts)
    - opts = opts || {}
    section.folio-case__section(class=[opts.tint ? 'folio-case__section--tint' : null, opts.final ? 'folio-case__section--final' : null] aria-labelledby=opts.labelledby)
        if opts.prose === false
            block
        else
            .folio-case__prose
                block
            if opts.figure
                +caseFigure(opts.figure)

//- Simple image figure. fig: { class, labelledby, src, alt, width, height, loading,
//- fetchpriority, caption, captionId }.
mixin caseFigure(fig)
    - const imageInfo = folioImageVariants["/" + fig.src.replace(/^\//, "")] || {}
    figure.folio-case__figure(id=fig.id class=fig.class aria-labelledby=fig.labelledby)
        img(src=fig.src srcset=folioSrcset(fig.src) sizes=fig.sizes || "(max-width: 600px) calc(100vw - 64px), (max-width: 900px) calc(100vw - 112px), 880px" alt=fig.alt width=imageInfo.width || fig.width height=imageInfo.height || fig.height loading=fig.loading fetchpriority=fig.fetchpriority)
//- Gold outcome block. The prose paragraphs stay in the caller as a block.
mixin caseOutcome(id, title, label)
    section.folio-case__outcome(aria-labelledby=id)
        .folio-case__outcome-inner
            p.folio-eyebrow= label || "S — Success"
            h2(id=id)= title
            block

//- Text-native diagrams stay readable at enlarged text sizes and without images.
//- opts: {id, title, nodes:[{label, detail}], caption, class}.
mixin storyFlow(opts)
    figure.folio-story-flow(id=opts.id class=opts.class aria-labelledby=opts.id + "-title")
        .folio-story-flow__body
            p.folio-story-flow__title(id=opts.id + "-title")= opts.title
            ol.folio-story-flow__nodes
                each node in opts.nodes
                    li
                        strong= node.label
                        span= node.detail
//- opts: {id, title, columns:[{label, title, detail, items:[string]}], caption}.
mixin storyComparison(opts)
    figure.folio-story-compare(id=opts.id aria-labelledby=opts.id + "-title")
        p.folio-story-flow__title(id=opts.id + "-title")= opts.title
        .folio-story-compare__columns
            each column in opts.columns
                .folio-story-compare__column
                    p.folio-story-compare__label= column.label
                    p.folio-story-compare__heading= column.title
                    if column.detail
                        p.folio-story-compare__detail= column.detail
                    if column.items
                        ul
                            each item in column.items
                                li= item
mixin caseResults(items, source)
    dl.folio-case-results
        each item in items
            div
                dt= item.value
                dd= item.label
    if source
        p.folio-case-results__source= source

//- Back-to-work footer. href/label default to today's shared destination.
mixin caseBack(href, label)
    footer.folio-case__footer
        a.folio-case__back(href=(href || '/#work'))= label || 'Back to selected work'

//- Dark callout used as a pull quote. Reuses the existing .folio-case__callout styling.
mixin pullQuote(quote, cite)
    aside.folio-case__callout.folio-case__callout--quote
        .folio-case__callout-inner
            blockquote.folio-case__quote
                p= quote
                if cite
                    footer.folio-case__quote-cite= cite

//- Structure for a pair of screenshots with HTML callouts.
//- opts: { labelledby, images:[{src,alt,width,height}], callouts:[string], caption, captionId }.
//- Available for the Classroom annotated pair; not inserted in this task.
mixin annotatedFrame(opts)
    - opts = opts || {}
    figure.folio-case__figure.folio-case__frame(aria-labelledby=opts.labelledby)
        .folio-case__frame-pair
            each image in (opts.images || [])
                .folio-case__frame-shot
                    img(src=image.src alt=image.alt width=image.width height=image.height loading="lazy")
        if opts.callouts && opts.callouts.length
            ol.folio-case__frame-callouts
                each callout in opts.callouts
                    li.folio-case__frame-callout= callout
//- Green Loom object-relationship diagram.
//- opts: { labelledby, kicker, mark, nodes:[{label,detail}], support:[{term,detail}], caption, captionId }.
mixin objectPath(opts)
    figure.folio-case__figure.green-case__figure(aria-labelledby=opts.labelledby)
        .green-case__hero-art
            .green-case__hero-head
                span.green-case__hero-kicker= opts.kicker
                span.green-case__hero-mark= opts.mark
            ol.green-case__model-path
                each node in opts.nodes
                    li.green-case__model-node
                        span.green-case__model-label= node.label
                        span.green-case__model-detail= node.detail
            .green-case__model-support
                each item in opts.support
                    p
                        strong= item.term
                        span= item.detail
//- Numbered workflow diagram.
//- opts: { labelledby, variant, title, steps:[{term,detail}], note, caption, captionId }.
mixin stepList(opts)
    figure.folio-case__figure.green-case__figure(id=opts.captionId aria-labelledby=opts.captionId + "-title")
        .green-case__diagram(class=opts.variant)
            if opts.title
                p.green-case__diagram-title(id=opts.captionId + "-title")= opts.title
            ol.green-case__steps
                each step in opts.steps
                    li
                        strong= step.term
                        span= step.detail
            if opts.note
                p.green-case__diagram-note= opts.note
//- Shared devices for layered reading, exact interface states, and prototype boundaries.
mixin caseDisclosure(label)
    details.case-disclosure
        summary
            span.case-disclosure__label= label
            span.case-disclosure__icon(aria-hidden="true")
                span.case-disclosure__expand
                    +folioIcon('expand')
                span.case-disclosure__shrink
                    +folioIcon('shrink')
        .case-disclosure__body
            block

mixin artifactStates(opts)
    figure.artifact-states(id=opts.id)
        .artifact-states__columns
            each state in opts.states
                section.artifact-state(aria-label=state.name)
                    p.artifact-state__label= state.name
                    h3= state.title
                    p.artifact-state__status= state.status
                    p= state.detail
                    span.artifact-state__action= state.action
mixin prototypeFrame(opts)
    figure.green-prototype(id=opts.id aria-labelledby=opts.titleId)
        .folio-case__prose
            p.folio-eyebrow Interactive example
            h3(id=opts.titleId)= opts.title
            p= opts.instructions
        iframe.green-prototype__frame(src=opts.src title=opts.frameTitle loading="lazy")
        noscript
            p= opts.fallback


//- Readable annotations stay useful when a screenshot is too dense to inspect.
mixin evidenceExcerpt(opts)
    aside.evidence-excerpt(aria-labelledby=opts.id)
        h3(id=opts.id)= opts.title
        dl
            each item in opts.items
                div
                    dt= item.term
                    dd= item.detail

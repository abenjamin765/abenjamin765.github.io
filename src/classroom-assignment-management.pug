include includes/folio-shared.pug

html(lang="en")
    head
        +folioHead('Teachers see who needs support | Aaron Benjamin', 'How Aaron Benjamin redesigned a cross-product assignments hub so teachers could prioritize students who need support.', '/classroom-assignment-management.html')
    body.folio.folio--case
        mixin assignment(title, stats, due, icon, locked, active)
            - const isReading = title.indexOf('Reading Activity:') === 0
            - const isMathChallenge = title.indexOf('Math Challenge:') === 0
            - const variant = Number(due.split('/')[1])
            - const resultTotal = isReading ? 24 + (variant % 3) * 4 : (isMathChallenge ? 10 : 12)
            - const studentNames = ['Aisha Patel', 'Amara Okafor', 'Ava Coleman', 'Benjamin Frost', 'Caleb Nguyen', 'Diego Fuentes', 'Elena Voss', 'Fatima Khan', 'Gabriel Ortiz', 'Harper Lee', 'Isaac Moreno', 'Jasmine Kim']
            - const counts = stats.match(/\d+/g).map(Number)
            - const totalStudents = counts[0] + counts[1] + counts[2]
            - const notStartedRows = Math.min(7, Math.round(counts[2] / totalStudents * 7))
            - const inProgressRows = Math.min(7 - notStartedRows, Math.round(counts[1] / totalStudents * 7))
            details.folio-demo__assignment(open=active)
                summary.folio-demo__assignment-summary
                    span.folio-demo__assignment-main
                        span.folio-demo__icon-tile
                            img(src='assets/img/folio/project--assignment-management/demo-icons/' + icon + '.svg', alt="")
                        span.folio-demo__assignment-body
                            span.folio-demo__assignment-title= title
                            span.folio-demo__assignment-meta= stats
                    span.folio-demo__assignment-actions
                        if locked
                            img.folio-demo__lock(src="assets/img/folio/project--assignment-management/demo-icons/lock.svg", alt="Locked assignment")
                        span.folio-demo__due= 'Due ' + due
                        img.folio-demo__ellipsis(src="assets/img/folio/project--assignment-management/demo-icons/ellipsis.svg", alt="")
                .folio-demo__student-progress
                    .folio-demo__table-wrap(tabindex="0" aria-label='Student progress table for ' + title + '. Scroll horizontally on smaller screens.')
                        table.folio-demo__table
                            caption.visually-hidden= 'Student progress for ' + title
                            thead
                                tr
                                    th(scope="col" aria-sort="none")
                                        button.folio-demo__table-heading.folio-demo__sort-button(type="button" data-sort-key="student" aria-label="Sort students by name")
                                            span Student
                                            img(src="assets/img/folio/project--assignment-management/demo-icons/angles-up-down.svg", alt="")
                                    th(scope="col" aria-sort="ascending")
                                        button.folio-demo__table-heading.folio-demo__sort-button(type="button" data-sort-key="status" aria-label="Sort by status urgency")
                                            span Status
                                            img(src="assets/img/folio/project--assignment-management/demo-icons/angles-up-down.svg", alt="")
                                    th(scope="col" aria-sort="none")
                                        button.folio-demo__table-heading.folio-demo__table-heading--score.folio-demo__sort-button(type="button" data-sort-key="result" aria-label=isReading ? "Sort by pages read" : "Sort by correct answers")
                                            span= isReading ? 'Pages read' : 'Correct'
                                            img(src="assets/img/folio/project--assignment-management/demo-icons/angles-up-down.svg", alt="")
                            tbody
                                each rowIndex in [0, 1, 2, 3, 4, 5, 6]
                                    - const progressState = (rowIndex + variant) % 7
                                    - const isNotStarted = progressState < notStartedRows
                                    - const isInProgress = !isNotStarted && progressState < notStartedRows + inProgressRows
                                    - const status = isNotStarted ? 'Not started' : (isInProgress ? 'In progress' : 'Completed in ' + (11 + ((rowIndex * 3 + variant) % 14)) + 'm')
                                    - const resultValue = isInProgress ? Math.max(1, Math.floor(resultTotal * (0.3 + ((rowIndex + variant) % 3) * 0.15))) : Math.max(1, resultTotal - ((rowIndex * 2 + variant) % 4))
                                    - const resultPercent = Math.round(resultValue / resultTotal * 100)
                                    tr
                                        th(scope="row")= studentNames[(rowIndex + variant) % studentNames.length]
                                        td.folio-demo__status(class=isNotStarted ? 'folio-demo__status--not-started' : (isInProgress ? 'folio-demo__status--in-progress' : null))= status
                                        td
                                            if isNotStarted
                                                | —
                                            else if isReading
                                                | #{resultValue} of #{resultTotal} pages
                                            else
                                                | #{resultValue} / #{resultTotal} (#{resultPercent}%)

        a.visually-hidden(href="#main") Skip to content

        .folio__decor(aria-hidden="true")
            img.folio__decor-img(src="assets/img/folio/blob.svg", alt="")

        +folioHeader('work')

        main#main.folio-main.folio-main--case
            article.folio-case
                header.folio-case__hero
                    figure.folio-case__hero-media
                        img(src="assets/img/folio/project--assignment-management/assignment-management--hero.png", alt="Renaissance Intelligence assignment view showing new, overdue, due soon, in-progress, and completed assignments grouped by priority" width="1920" height="1436" fetchpriority="high")
                    .folio-case__intro
                        p.folio-eyebrow Case study
                        h1 Teachers see who needs support
                        p.folio-case__dek I replaced a dense assignments table with a priority view so K-12 teachers could find the students who needed attention.
                        p.folio-case__context
                            | More than 40% of U.S. schools rely on&#32;
                            a(href="https://www.renaissance.com/about-us/" target="_blank" rel="noopener noreferrer") Renaissance
                            |  for learning data and insights.
                    dl.folio-case__facts
                        .folio-case__fact
                            dt Role
                            dd Senior UX Designer
                        .folio-case__fact
                            dt Team
                            dd Product manager, product owner, three engineers, and UX research partners
                        .folio-case__fact
                            dt Timeline
                            dd Four weeks of research and design, followed by two weeks of development
                        .folio-case__fact
                            dt Outcome
                            dd Met the initiative's hub-adoption goal and reduced transitions to individual-product reports

                section.folio-case__section(aria-labelledby="research-title")
                    .folio-case__prose
                        h2#research-title Research showed where the page fell short
                        p The first version brought assignments from several products into one place, but it did not help teachers act. A teacher could see that eight of ten students had finished, then still had to open another report to identify the two who had not.
                        p Our UX research partners ran moderated studies with five active Renaissance users and five teachers new to the product suite. Participants reviewed the existing page and two prototypes, found specific assignments, and explained how they would use the feature in the classroom. Teachers had to sort and filter the table before they could identify students who needed help. They also prioritized due date over assigned date when deciding what to address first.
                    figure.folio-case__figure
                        img(src="assets/img/folio/project--assignment-management/assignment-management--current-page.png", alt="Version 1 of the Assignments and Assessments page showing filters and a dense table of assignments")
                        figcaption Version 1 aggregated assignments, but left teachers to do the prioritization work themselves.

                section.folio-case__section.folio-case__section--tint(aria-labelledby="model-title")
                    .folio-case__prose
                        h2#model-title A shared model clarified the interface
                        p Each practice and assessment product had its own assignment data. I facilitated an object-modeling workshop with product and engineering partners to define the shared assignment object, its product-specific differences, and the information teachers needed in the classroom.
                        p Every assignment had a title, type, assigned date, and due date. Some attributes varied by product, such as questions answered or pages read. The interface needed to surface the shared information first while retaining product context through labels and icons.
                    figure.folio-case__figure
                        img(src="assets/img/folio/project--assignment-management/assignment-management--object-model.png", alt="Assignment object model showing shared assignment attributes alongside attributes specific to live lessons and reading activities")
                        figcaption The object model separated the attributes every assignment shared from product-specific detail.

                section.folio-case__section(aria-labelledby="decision-title")
                    .folio-case__prose
                        h2#decision-title I replaced the table with a priority view
                        p I replaced the table with grouped lists. The table offered controls, but it left teachers to decide what to sort and filter before they could act.
                        p The final design placed new assignments first, then grouped the remaining work by overdue, due soon, in progress, and done. Teachers could expand or collapse each group. Every participant in the study validated this model. One teacher responded, “OMG, this is amazing.”
                    figure.folio-case__figure
                        img(src="assets/img/folio/project--assignment-management/assignment-management--wireframe.png", alt="Early wireframe of grouped assignment cards organized by new, overdue, due soon, in progress, and done")
                        figcaption This wireframe tested priority groups in place of the Version 1 table controls.

                section.folio-case__section.folio-case__section--final(aria-labelledby="final-design-title")
                    .folio-case__prose
                        h2#final-design-title The final design kept student progress in context
                        p Teachers could scan by urgency and open an assignment without leaving the hub. The expanded view showed who had started, finished, or still needed support.
                    .folio-demo(aria-label="Interactive reconstruction of the final assignments view")
                        p.folio-demo__note Interactive reconstruction of the final design. Student names and results are illustrative.
                        .folio-demo__canvas
                            details.folio-demo__group(open)
                                summary.folio-demo__group-summary
                                    img.folio-demo__angle(src="assets/img/folio/project--assignment-management/demo-icons/angle-down.svg", alt="")
                                    span New assignments (1)
                                .folio-demo__group-content
                                    +assignment('Skill Practice: Symmetry & Transformations', '3 complete, 17 in progress, 8 not started', '9/27', 'lightbulb', false, false)

                            details.folio-demo__group(open)
                                summary.folio-demo__group-summary
                                    img.folio-demo__angle(src="assets/img/folio/project--assignment-management/demo-icons/angle-down.svg", alt="")
                                    span Overdue (2)
                                .folio-demo__group-content.folio-demo__group-content--assignments
                                    +assignment('Reading Activity: The Long Winter, Chapter 4', '11 complete, 4 in progress, 13 not started', '9/17', 'book-spine', false, true)
                                    +assignment('Skill Practice: Fraction Models', '7 complete, 5 in progress, 16 not started', '9/18', 'lightbulb', true, false)
                                    +assignment('Math Challenge: Area & Perimeter', '9 complete, 6 in progress, 13 not started', '9/19', 'calculator', false, false)

                            details.folio-demo__group
                                summary.folio-demo__group-summary
                                    img.folio-demo__angle(src="assets/img/folio/project--assignment-management/demo-icons/angle-down.svg", alt="")
                                    span Due soon (3)
                                .folio-demo__group-content.folio-demo__group-content--assignments
                                    +assignment('Skill Practice: Equivalent Fractions', '12 complete, 10 in progress, 4 not started', '9/22', 'lightbulb', false, false)
                                    +assignment('Reading Activity: The One and Only Ivan, Chapter 6', '15 complete, 7 in progress, 4 not started', '9/23', 'book-spine', false, false)
                                    +assignment('Math Challenge: Ratios & Proportions', '8 complete, 11 in progress, 7 not started', '9/24', 'calculator', false, false)
                            details.folio-demo__group
                                summary.folio-demo__group-summary
                                    img.folio-demo__angle(src="assets/img/folio/project--assignment-management/demo-icons/angle-down.svg", alt="")
                                    span In progress (5)
                                .folio-demo__group-content.folio-demo__group-content--assignments
                                    +assignment('Skill Practice: Adding Integers', '18 complete, 6 in progress, 2 not started', '9/15', 'lightbulb', false, false)
                                    +assignment('Math Challenge: Algebraic Expressions', '13 complete, 9 in progress, 4 not started', '9/16', 'calculator', false, false)
                                    +assignment('Skill Practice: Word Relationships', '16 complete, 8 in progress, 2 not started', '9/16', 'lightbulb', false, false)
                                    +assignment('Reading Activity: Bud, Not Buddy, Chapter 8', '14 complete, 10 in progress, 2 not started', '9/17', 'book-spine', false, false)
                                    +assignment('Math Challenge: Decimal Operations', '11 complete, 12 in progress, 3 not started', '9/18', 'calculator', false, false)
                            details.folio-demo__group
                                summary.folio-demo__group-summary
                                    img.folio-demo__angle(src="assets/img/folio/project--assignment-management/demo-icons/angle-down.svg", alt="")
                                    span Done (12)
                                .folio-demo__group-content.folio-demo__group-content--assignments
                                    +assignment('Skill Practice: Sentence Structure', '26 complete, 0 in progress, 0 not started', '9/5', 'lightbulb', false, false)
                                    +assignment('Math Challenge: Multiplying Decimals', '25 complete, 1 in progress, 0 not started', '9/6', 'calculator', false, false)
                                    +assignment('Skill Practice: Context Clues', '26 complete, 0 in progress, 0 not started', '9/7', 'lightbulb', false, false)
                                    +assignment('Reading Activity: Holes, Chapter 3', '24 complete, 2 in progress, 0 not started', '9/8', 'book-spine', false, false)
                                    +assignment('Math Challenge: Percent Problems', '26 complete, 0 in progress, 0 not started', '9/9', 'calculator', false, false)
                                    +assignment('Skill Practice: Main Idea', '25 complete, 1 in progress, 0 not started', '9/10', 'lightbulb', false, false)
                                    +assignment('Reading Activity: Esperanza Rising, Chapter 2', '26 complete, 0 in progress, 0 not started', '9/11', 'book-spine', false, false)
                                    +assignment('Math Challenge: Coordinate Planes', '23 complete, 3 in progress, 0 not started', '9/12', 'calculator', false, false)
                                    +assignment('Skill Practice: Prefixes and Suffixes', '26 complete, 0 in progress, 0 not started', '9/13', 'lightbulb', false, false)
                                    +assignment('Reading Activity: The Giver, Chapter 1', '24 complete, 2 in progress, 0 not started', '9/14', 'book-spine', false, false)
                                    +assignment('Math Challenge: Volume', '26 complete, 0 in progress, 0 not started', '9/15', 'calculator', false, false)
                                    +assignment('Skill Practice: Vocabulary Review', '25 complete, 1 in progress, 0 not started', '9/16', 'lightbulb', false, false)

                section.folio-case__section.folio-case__section--tint(aria-labelledby="constraints-title")
                    .folio-case__prose
                        h2#constraints-title I designed for the product's technical constraints
                        p I co-authored the requirements and owned the information architecture, interaction patterns, page content, states, prototypes, handoff, and launch planning.
                        p The Angular page shell rendered content from a React app in an iframe, which constrained layout, filters, dialogs, and other interactions. The initial API returned aggregate completion counts only. With engineering and API owners, I added student IDs, completion time, and timeframe pre-filtering. That made student names visible in the interface while protecting page performance.
                        p We deferred a fuller student-performance summary for a later release. Teachers wanted more detail, but adding it would have delayed the core improvement: helping teachers identify which assignments and students needed attention.

                aside.folio-case__callout(aria-labelledby="alignment-title")
                    .folio-case__callout-inner
                        p.folio-eyebrow Collaboration
                        h2#alignment-title How I aligned the team
                        p I used the Design Dash toolset I built in working sessions with product, research, and engineering. AI-assisted prototypes with realistic mock data helped us compare options in real time, carry forward useful patterns, and record decisions and open questions for implementation.

                section.folio-case__outcome(aria-labelledby="outcome-title")
                    .folio-case__outcome-inner
                        p.folio-eyebrow Outcome
                        h2#outcome-title A clearer path from status to action
                        p After four weeks of research and design iteration and two weeks of development, Version 2 launched. It met the initiative's goal of moving users from individual products into Renaissance Intelligence. Product metrics showed fewer transitions from the Assignments page to individual-product reports, and research confirmed that the grouped view matched teachers' expectations.
                        p The structure also left room for richer data without making the core workflow harder to scan. My takeaway: defaults should reflect how people prioritize work while keeping the underlying detail close at hand.

                footer.folio-case__footer
                    a.folio-case__back(href="/#work") Back to selected work

            +folioFooter

        script(src="assets/js/assignment-demo.js" defer)
